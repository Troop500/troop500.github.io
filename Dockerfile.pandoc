FROM pandoc/latex:latest

# Install curl for health checking Jekyll, Python3 for image processing, and additional LaTeX packages
RUN apk add --no-cache curl bash python3
RUN tlmgr update --self && tlmgr install wrapfig float fancyhdr setspace

# Copy scripts
COPY scripts/ /scripts/
RUN chmod +x /scripts/build/*.sh

# Set working directory to match Jekyll
WORKDIR /srv/jekyll

# Override the entrypoint and command to run our bash script
ENTRYPOINT []
CMD ["bash", "/scripts/build/build-handbook-simple.sh"]
