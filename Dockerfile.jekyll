# Simple Jekyll container for faster builds
FROM jekyll/jekyll:latest

# Set working directory
WORKDIR /srv/jekyll

# Copy Gemfile, Gemfile.lock, and gemspec first for better layer caching
COPY --chown=jekyll:jekyll Gemfile* millennial.gemspec ./

# Install dependencies
RUN bundle install

# Copy the rest of the project
COPY --chown=jekyll:jekyll . .

# Expose port 4000
EXPOSE 4000

# Default command
CMD ["bundle", "exec", "jekyll", "serve", "--host", "0.0.0.0", "--livereload"]
